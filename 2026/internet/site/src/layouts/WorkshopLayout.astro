---
import '@fontsource-variable/vazirmatn'
import '../styles/global.css'

const {
  title,
  description = 'مسیر تعاملی کارگاه اینترنت رستا برای کشف ایده‌های شبکه، قدم‌به‌قدم و با آزمون‌وخطا.',
  shareImage = true,
} = Astro.props
const base = import.meta.env.BASE_URL
const socialImage = new URL(`${base}og.png`, Astro.site)
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title} — کارگاه اینترنت رستا</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:title" content={`${title} — کارگاه اینترنت رستا`} />
    <meta property="og:description" content={description} />
    {shareImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={`${title} — کارگاه اینترنت رستا`} />
    <meta name="twitter:description" content={description} />
    {shareImage && <meta name="twitter:image" content={socialImage} />}
  </head>
  <body>
    <div class="network-backdrop" aria-hidden="true">
      <span class="network-node node-one"></span>
      <span class="network-node node-two"></span>
      <span class="network-node node-three"></span>
      <span class="network-link link-one"></span>
      <span class="network-link link-two"></span>
    </div>
    <main class="page-shell">
      <slot />
    </main>
  </body>
</html>
