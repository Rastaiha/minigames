{
  "version": 1,
  "title": "مینی‌گیم‌های مدل‌های زبانی",
  "continueOnError": true,
  "commands": {
    "install": [["npm", "ci"]],
    "check": [["npm", "run", "check"]],
    "build": [["node", "scripts/update-readme.js"]],
    "ciSetup": [["python3", "-m", "pip", "install", "pre-commit"]],
    "ciCheck": [
      [
        "pre-commit",
        "run",
        "--all-files",
        "--config",
        ".pre-commit-config.yaml"
      ],
      ["npm", "run", "test:browser"]
    ],
    "dev": [["python3", "-m", "http.server", "5173", "--bind", "127.0.0.1"]]
  },
  "publish": {
    "directory": ".",
    "readmeHomepage": "README.md",
    "include": [
      "archive",
      "attention",
      "contexual-embedding",
      "dimensionality-reduction",
      "fonts",
      "hallucination",
      "jailbreak",
      "model-lab",
      "next-token-prediction2",
      "next-token-prediction3",
      "pretrained-llm",
      "pretraining-box",
      "random-llm",
      "rlhf-llm",
      "sft-llm",
      "shared",
      "transformer",
      "word-embedding",
      "word-in-line",
      "word-in-space",
      "wordembedding",
      "words-and-vectors",
      "words-world",
      "random-generator.js"
    ],
    "extensions": [".html", ".css", ".js", ".ttf", ".otf"]
  },
  "entries": [
    "archive/Dimensions/1-line.html",
    "archive/Dimensions/2-plane.html",
    "archive/Dimensions/3-space.html",
    "archive/bpe-tree/index.html",
    "archive/jailbreak-old/index.html",
    "archive/llm2.html",
    "archive/next-token-prediction/index.html",
    "attention/index.html",
    "contexual-embedding/index.html",
    "dimensionality-reduction/index.html",
    "hallucination/index.html",
    "hallucination/level1.html",
    "hallucination/level2.html",
    "jailbreak/index.html",
    "jailbreak/level1.html",
    "jailbreak/level2.html",
    "model-lab/index.html",
    "next-token-prediction2/index.html",
    "next-token-prediction3/index.html",
    "pretrained-llm/index.html",
    "pretraining-box/index.html",
    "random-llm/index.html",
    "rlhf-llm/index.html",
    "sft-llm/index.html",
    "transformer/decoder.html",
    "transformer/encoder.html",
    "word-embedding/index.html",
    "word-in-line/index.html",
    "word-in-space/index.html",
    "word-in-space/vectors.html",
    "wordembedding/index.html",
    "words-and-vectors/index.html",
    "words-world/index.html"
  ]
}
