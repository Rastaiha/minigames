{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pretrained-llm-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-09-04",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://rastaiha.github.io",
    "GEMINI_MODEL": "gemini-3.5-flash-lite"
  },
  "secrets": {
    "required": ["GEMINI_API_KEY"]
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
